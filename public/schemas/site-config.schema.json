        "masjidName": {
          "type": "string",
          "const": "Shaheed Bilal Masjid (Islamic Cultural and Education Centre)"
        },
        "legalCharityName": {
          "type": "string",
          "const": "Irish Islamic Da'awah and Education Trust"
        },
        "charitiesRegulatorNumber": {
          "type": "string",
          "const": "20069506"
        },
        "revenueCharityTaxNumber": {
          "type": "string",
          "const": "CHY. 18219"
        },
        "address": {
          "type": "object",
          "properties": {
            "street": {
              "type": "string",
              "const": "Warrenstown House"
            },
            "locality": {
              "type": "string",
              "const": "Blanchardstown"
            },
            "city": {
              "type": "string",
              "const": "Dublin 15"
            },
            "eircode": {
              "type": "string",
              "const": "D15 ET27"
            },
            "country": {
              "type": "string",
              "const": "Ireland"
            },
            "formatted": {
              "type": "string",
              "const": "Warrenstown House, Blanchardstown, Dublin 15, D15 ET27, Ireland"
            }
          },
          "required": [
            "street",
            "locality",
            "city",
            "eircode",
            "country",
            "formatted"
