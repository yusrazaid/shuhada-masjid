            "longitude": {
              "type": "number",
              "const": -6.386
            }
          },
          "required": [
            "latitude",
            "longitude"
          ],
          "additionalProperties": false
        },
        "timezone": {
          "type": "string",
          "const": "Europe/Dublin"
        },
        "phone": {
          "type": "string",
          "const": "+353 1 821 8748"
        },
        "displayPhone": {
          "type": "string",
          "const": "01 821 8748"
        },
        "email": {
          "type": "string",
          "const": "info@shuhadafoundation.com"
        },
        "domains": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
