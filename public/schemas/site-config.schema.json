      "required": [
        "organizationName",
        "masjidName",
        "legalCharityName",
        "charitiesRegulatorNumber",
        "revenueCharityTaxNumber",
        "address",
        "coordinates",
        "timezone",
        "phone",
        "displayPhone",
        "email",
        "domains",
        "sisterSchools",
        "description"
