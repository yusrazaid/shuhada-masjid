# ============================================================================
# Shuhada Foundation of Ireland — WhatsApp Coordinator Agent Configuration
# Copy to .env.local (never commit real secrets) or add in Vercel Settings
# ============================================================================

# 1. Comma-separated E.164 phone numbers of authorized Mosque Coordinators
# Example: +353871234567,+353869876543
WHATSAPP_ALLOWED_NUMBERS=

# 2. GitHub Personal Access Token (Fine-Grained PAT scoped ONLY to yusrazaid/shuhada-masjid Contents: Read & Write)
GITHUB_TOKEN=
GITHUB_REPOSITORY=yusrazaid/shuhada-masjid
GITHUB_BRANCH=main

# 3. Optional Vercel Deploy Hook URL (Settings -> Git -> Deploy Hooks)
VERCEL_DEPLOY_HOOK_URL=

# 4. Optional AI Natural-Language Parser (if omitted, deterministic command parser is used)
GEMINI_API_KEY=
OPENAI_API_KEY=

# 5. Optional Meta Official WhatsApp Cloud API settings
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# 6. Optional Direct API Bearer Secret (for testing via curl/webhooks)
COORDINATOR_API_SECRET=
