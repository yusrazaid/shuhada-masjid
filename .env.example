# ============================================================================
# Shuhada Foundation of Ireland — WhatsApp Coordinator Agent Configuration
# Copy to .env.local (never commit real secrets) or add in Vercel Settings
# ============================================================================

# 1. Comma-separated E.164 phone numbers of authorized Mosque Coordinators
# Example: +447526992368,+353871234567
WHATSAPP_ALLOWED_NUMBERS=

# 2. Webhook Authentication (use ONE of these for Twilio / Meta / Direct API)
# - Twilio: set TWILIO_AUTH_TOKEN (verifies X-Twilio-Signature) OR WHATSAPP_WEBHOOK_TOKEN (?token=...)
# - Meta Cloud API: set WHATSAPP_APP_SECRET (verifies X-Hub-Signature-256)
# - Direct API: set COORDINATOR_API_SECRET (Authorization: Bearer ...)
TWILIO_AUTH_TOKEN=
WHATSAPP_WEBHOOK_TOKEN=
COORDINATOR_API_SECRET=

# 3. GitHub Fine-Grained PAT scoped ONLY to yusrazaid/shuhada-masjid (Contents: Read & Write)
GITHUB_TOKEN=
GITHUB_REPOSITORY=yusrazaid/shuhada-masjid
GITHUB_BRANCH=main

# 4. Optional Vercel Deploy Hook URL (Settings -> Git -> Deploy Hooks)
VERCEL_DEPLOY_HOOK_URL=

# 5. Optional AI Natural-Language Parser (if omitted, deterministic command parser is used)
GEMINI_API_KEY=
OPENAI_API_KEY=

# 6. Optional Meta Official WhatsApp Cloud API settings
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
